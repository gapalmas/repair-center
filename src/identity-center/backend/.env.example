# ═══════════════════════════════════════════════════════════════
# Variables de Entorno — IdentityCenter
# ═══════════════════════════════════════════════════════════════
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env a GitHub (ya está en .gitignore).

# --- PostgreSQL (requerida) ---
ConnectionStrings__IdentityPostgreSQL=Host=localhost;Port=5432;Database=identitycenter;Username=postgres;Password=TU_PASSWORD_AQUI

# --- JWT ---
Jwt__Secret=TU_SECRET_KEY_AQUI_MIN_32_CHARS
Jwt__Issuer=IdentityCenter
Jwt__Audience=PlatformClients
Jwt__ExpirationMinutes=60

# --- Bootstrap seguro ---
Bootstrap__Enabled=true
Bootstrap__ApplyMigrationsOnStartup=true
Bootstrap__EnsureBaseRoles=true
Bootstrap__EnsureSystemTenant=true
Bootstrap__EnsureInitialSuperAdmin=true
Bootstrap__AllowPasswordResetIfAdminExists=false
Bootstrap__ForcePasswordChangeOnBootstrapAdmin=true
Bootstrap__SystemTenantName=Sistema Interno IdentityCenter
Bootstrap__SystemTenantEmail=identity@repairmodel.local
Bootstrap__SystemTenantDescription=Tenant tecnico reservado para la administracion inicial del sistema.
Bootstrap__AdminEmail=admin@repairmodel.local
Bootstrap__AdminPassword=AdminTemp#2026!
Bootstrap__AdminFirstName=Administrador
Bootstrap__AdminLastName=Inicial

{
  "ConnectionStrings": {
    "IdentityPostgreSQL": ""
  },
  "AuthSecurity": {
    "AllowedOrigins": []
  },
  "Bootstrap": {
    "Enabled": true,
    "ApplyMigrationsOnStartup": true,
    "EnsureBaseRoles": true,
    "EnsureSystemTenant": true,
    "EnsureInitialSuperAdmin": true,
    "AllowPasswordResetIfAdminExists": false,
    "ForcePasswordChangeOnBootstrapAdmin": true,
    "SystemTenantName": "Sistema Interno IdentityCenter",
    "SystemTenantEmail": "identity@repairmodel.local",
    "SystemTenantDescription": "Tenant tecnico reservado para la administracion inicial del sistema.",
    "AdminEmail": "admin@repairmodel.local",
    "AdminPassword": "",
    "AdminFirstName": "Administrador",
    "AdminLastName": "Inicial"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
